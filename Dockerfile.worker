# BullMQ worker image for Railway.
# Optional alternative to Nixpacks (configured in railway.json). Use this by setting
# Railway service "Builder" to "Dockerfile" and "Dockerfile Path" to "Dockerfile.worker".

FROM node:24-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    NODE_ENV=production
RUN corepack enable

# Install yt-dlp (single-file binary) and ffmpeg (required by yt-dlp to merge audio streams)
RUN apt-get update && apt-get install -y ffmpeg curl ca-certificates --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
       -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

WORKDIR /app

# --- Dependencies layer (cached unless lockfile changes) ---
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

# --- Runtime layer ---
FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml tsconfig.json drizzle.config.ts ./
COPY src ./src
COPY scripts ./scripts
COPY drizzle ./drizzle

# Healthcheck: process must be alive. BullMQ workers are not HTTP, so we check the
# Node process with a lightweight Redis ping via the worker's connection.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1

CMD ["pnpm", "run", "worker"]
